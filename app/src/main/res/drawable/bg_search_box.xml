<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#222634" />
            <stroke android:width="2.5dp" android:color="@color/focus_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#191C26" />
            <stroke android:width="1dp" android:color="#2C3142" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
